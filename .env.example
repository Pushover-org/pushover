# Copy to .env.local at the repo root and fill in. Never commit real values.

# --- PayPal (two sandbox apps) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_GUARDED_CLIENT_ID=
PAYPAL_GUARDED_CLIENT_SECRET=
PAYPAL_GUARDED_WEBHOOK_ID=
PAYPAL_BASELINE_CLIENT_ID=
PAYPAL_BASELINE_CLIENT_SECRET=
PAYPAL_RPM=40                     # shared token bucket, below the 50/min sandbox limit

# --- Anthropic ---
ANTHROPIC_API_KEY=                # empty: proof claims go to a person unread (e2e runs this way)
PUSHOVER_MODEL=claude-haiku-5-5
COMPARE_MODEL=claude-sonnet-5-5
DEMO_AI_BUDGET_USD=1              # the web app's examiner spend cap; resets when the server restarts

# --- App ---
DATABASE_URL=
SESSION_SECRET=                   # 32+ random bytes; signs the claimant's PayPal identity cookie
NETWORK_SECRET=                   # keys the network hashes for C9 and login throttling (no raw IPs stored)
PAYER_SEAL_KEY=                   # 32 random bytes, base64: AES-256-GCM for PayPal payer IDs at rest
PAYER_PSEUDONYM_KEY=              # 32 random bytes, base64: per-settlement pseudonyms of payer IDs
PAYPAL_LOGIN_RETURN_URL=          # optional; default <origin>/api/paypal/callback (must be a Return URL on the app)

# --- Demo analyst logins (shown on /judge; play money only) ---
JUDGE_ANALYST_PASSWORD=           # 12+ characters; `pnpm demo:analysts` creates both accounts
JUDGE_SUPERVISOR_PASSWORD=

# --- AG Studio ---
AG_STUDIO_LICENSE_KEY=
# Bryntum Scheduler (the linked-group timeline). Without a key it runs as a 14-day trial with a badge.
BRYNTUM_LICENSE_KEY=
# Most the AG Studio desk agent may spend per server process, in USD (default 0.5).
STUDIO_AI_BUDGET_USD=
