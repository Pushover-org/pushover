# Copy to .env.local at the repo root and fill in. Never commit real values.

# --- PayPal (two sandbox apps) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_GUARDED_CLIENT_ID=
PAYPAL_GUARDED_CLIENT_SECRET=
PAYPAL_GUARDED_WEBHOOK_ID=
PAYPAL_BASELINE_CLIENT_ID=
PAYPAL_BASELINE_CLIENT_SECRET=
PAYPAL_RPM=40                     # shared token bucket, below the 50/min sandbox limit

# --- Anthropic ---
ANTHROPIC_API_KEY=
PUSHOVER_MODEL=claude-opus-5-5
COMPARE_MODEL=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=15            # global demo spend cap; Lab pauses when hit
AI_EVAL_BUDGET_USD=400            # hard cap per eval invocation

# --- App ---
DATABASE_URL=
SESSION_SECRET=                   # 32+ random bytes, base64
APP_ORIGIN=                       # e.g. https://<railway-generated-domain>, set after first deploy
MERCHANT_ADMIN_EMAIL=
MERCHANT_ADMIN_PASSWORD_HASH=     # argon2id hash, generated by scripts/hash-password.ts

# --- Policy (defaults; also stored in DB policy table) ---
POLICY_WINDOW_DAYS=30
POLICY_HUMAN_THRESHOLD_CENTS=25000
POLICY_DAILY_CAP_CENTS=200000
POLICY_VELOCITY_MAX=3
POLICY_VELOCITY_WINDOW_DAYS=30

# --- AG Studio ---
AG_STUDIO_LICENSE_KEY=
