{
  "name": "pushover",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "day1:d1-2": "node --env-file-if-exists=.env.local scripts/day1/d1-2-oauth-404.ts",
    "day1:d1-9": "node --env-file-if-exists=.env.local scripts/day1/d1-9-mock-response.ts",
    "day1:d1-3": "node --env-file-if-exists=.env.local scripts/day1/d1-3-card-seed.ts",
    "day1:d1-4": "node --env-file-if-exists=.env.local scripts/day1/d1-4-refund-idempotent.ts",
    "day1:d1-5": "node --env-file-if-exists=.env.local scripts/day1/d1-5-refund-no-key.ts",
    "receipts:download": "node scripts/receipts/download.ts",
    "corpus:build": "node packages/eval/scripts/build-claims-v1.ts",
    "corpus:images": "node packages/eval/scripts/materialise-claims-v1.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:migrate": "node --env-file-if-exists=.env.local packages/db/src/bin/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.ts",
    "test:sandbox": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@pushover/db": "workspace:*",
    "@pushover/paypal": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
